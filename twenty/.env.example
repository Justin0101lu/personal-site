# Copy to .env and fill in. Generate each secret with: openssl rand -base64 32
TAG=v2.9.0
SERVER_URL=http://localhost:3000
STORAGE_TYPE=local

PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=postgres

ENCRYPTION_KEY=replace_me_with_a_random_string
APP_SECRET=

# ---- AI (needed for the assistant, skills and AI agent workflow steps) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Email (needed for the "Send email" workflow step; LOGGER just prints emails) ----
EMAIL_DRIVER=LOGGER
EMAIL_FROM_ADDRESS=you@yourdomain.com
EMAIL_FROM_NAME=Justin from Holography
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# ---- Google (optional: sign-in, Gmail sync, Calendar sync for meeting detection) ----
AUTH_GOOGLE_ENABLED=false
MESSAGING_PROVIDER_GMAIL_ENABLED=false
CALENDAR_PROVIDER_GOOGLE_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
